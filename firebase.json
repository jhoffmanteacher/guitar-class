{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "predeploy": [
      "node -e \"if (process.env.GITHUB_ACTIONS !== 'true') { console.error('The practice copy is published by GitHub only (.github/workflows/practice.yml), never by a firebase deploy typed on this computer: nothing was uploaded.'); process.exit(1); }\""
    ],
    "ignore": [
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "firebase.json",
      "firestore.rules",
      "firestore.rules.paste2",
      "firestore.indexes.json",
      "_config.yml",
      "**/*.md",
      "tools/**",
      "docs/**",
      "Relevant reference docs/**",
      "Claude outputs/**",
      "song-journey-build/**",
      "screens/**",
      "package.json",
      "package-lock.json",
      "eslint.config.mjs",
      "**/firebase-debug*.log",
      "**/firestore-debug.log",
      "**/*.zip",
      "**/guitar-class-backup-*",
      "**/mic-recordings-*",
      "**/mic-eval-*",
      "**/mic-*-*-*",
      "**/*.webm",
      "**/*.wav",
      "**/*.log",
      "**/*.py",
      "**/*.ps1",
      "**/*.mjs"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=600"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
