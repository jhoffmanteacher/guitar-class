rules_version = '2';

/* ══════════════════════════════════════════════════════════════════════
   Guitar Class — Firestore security rules

   THESE RULES ARE THE REAL SECURITY BOUNDARY. Everything in the app is
   client-side and therefore bypassable from DevTools: the ?teacher=true
   dashboard gate is a div swap, and the "paused" flag is a rendering
   choice. Only what is written here actually stops anyone.

   This file is the source of truth, but editing it changes NOTHING on its
   own — GitHub Pages does not deploy Firestore rules. Paste the contents
   into Firebase console → Firestore Database → Rules → Publish (or run
   `firebase deploy --only firestore:rules` if the CLI is ever set up).
   Keep this file and the console in sync; if they drift, the console wins
   and this file becomes a lie.

   The app only ever touches three paths (verified against app.js,
   teacher.js and tabs/journey.js):
     progress/{uid}   one doc per student: skills, responses, completed,
                      games, streak, practiceLog, name, email
     config/class     one shared doc: gamesEnabled, gameOverrides,
                      paused, archived, periodOverrides, hiddenActivities,
                      activityDates, activityTitles, activityNumbers,
                      activityClears, archivedActivities, deletedActivities,
                      optionalActivities, playAlongActivities, activityPins,
                      activityStudents,
                      activityBoard,
                      activityBoardSeeded, moduleOpenThrough,
                      micSampling, configVersion
                      (teacher writes, students read)
     liveQuiz/current the whole-class live quiz's state (teacher writes,
                      students read) + an answers/{uid} subcollection each
                      student writes their own row of
     issueReports/*   student-filed problem reports
     micTakes/*       consented mic recordings of one Listening Coach /
                      Note Runner / Power Chord Switch take (+ a chunks/{i} subcollection of
                      the audio) — student creates their own, teacher
                      reads and deletes
     micTakesMeta/count  the public "how many takes so far" counter
     minutesBoard/{uid}  one number per student, readable by every signed-in student (class rank)

   Anything not matched below is denied by default. Do not add a catch-all.
   ══════════════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* The one teacher account. email_verified matters: without it, anyone
       who could register this address under a provider that doesn't verify
       (enabling Email/Password is a single console toggle with no footprint
       in this repo) would read every student's work. Google sign-in — the
       only provider the app uses — always sets email_verified, so adding
       this does not lock the real teacher out. */
    function isTeacher() {
      return request.auth != null
          && request.auth.token.email == 'jhoffman@seq.org'
          && request.auth.token.email_verified == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    /* One document per student, keyed by uid.

       A student reads and writes ONLY their own. The teacher gets read —
       deliberately NOT write. The dashboard never needs to modify student
       work (pause and archive live in config/class precisely so they
       don't), and withholding write means a compromised teacher session
       cannot erase the class. If a destructive "wipe progress" button is
       ever added, it needs `allow delete: if isTeacher()` here, and that
       trade-off should be a deliberate decision rather than a default. */
    match /progress/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read: if isTeacher();
    }

    /* Class-wide settings. Every signed-in student must read this doc —
       app.js loadClassConfig() needs gamesEnabled/gameOverrides for the
       arcade, `paused` for the access hold, and `hiddenActivities` /
       `archivedActivities` / `deletedActivities` to skip any In-Class
       Activity the teacher has pulled back or retired — so it cannot be
       teacher-only.

       What that exposes: the uid→bool maps for the whole class (plus an
       activity-id→bool map, which isn't sensitive — activity ids already
       ship to every client in class-activities.js). It is limited in
       practice, because uids are opaque and a student cannot read anyone
       else's progress doc to map a uid back to a name. If that ever stops
       being acceptable, the fix is structural rather than a rules tweak:
       split into config/students/{uid} docs so each student can read only
       their own row.

       Scoped to the specific "class" doc — config/{doc} would let any
       signed-in user read every doc under config/, not just this one.

       `configVersion` is a counter the console bumps on every write, inside
       a transaction, so a second console cannot merge a patch it worked out
       from a copy of this doc that has since moved (teacherWriteConfig in
       teacher.js, checks.mjs 1ai). Deliberately NOT enforced here: a rule
       like `request.resource.data.configVersion == resource.data.configVersion + 1`
       would make the doc unwritable from the Firebase console by hand, which
       is the one repair path left when something goes wrong with it. The
       guard is there to stop an accident, not an attacker — and only the
       teacher can write this doc at all. */
    match /config/class {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    /* ── Live quiz (live-quiz.js) ──────────────────────────────────────
       One doc, rewritten from scratch each game. Only the teacher writes
       it: state, the current question number, the correct answer (written
       only at reveal) and the running scores. Every signed-in student
       reads it, which is what makes the game live.

       What that exposes: the `scores` map — every player's POINTS, keyed by
       uid — is readable by any signed-in account. It carries NO NAME
       (2026-11-05, Jonathan: no per-period minutes tied to a name, readable
       by anyone): names stay in answers/{uid} below (teacher-only), and the
       projected wall, which is the teacher's own screen, builds its
       leaderboard from those. Before that the scores map held every
       player's display name next to the uid, which tied every uid-keyed doc
       on the site (config/class's uid maps, the class rank, the minutes
       boards) to a person; the Top 5 board is keyed by a private tag as
       well, in case a name is ever published again. checks.mjs 1cm runs the
       writers and fails the push if a name gets back into this doc. OPEN: a
       person in the room sees the wall's names with points and can read this
       doc's uid -> points, so the top players' uids can be lined up with their
       names (see the Top 5 header below for the options).

       Scoped to the specific "current" doc rather than liveQuiz/{doc}, for
       the same reason config/class is: a wildcard would open every future
       document under liveQuiz/ to every signed-in user. */
    match /liveQuiz/current {
      allow read:  if isSignedIn();
      allow write: if isTeacher();

      /* One answer doc per student, keyed by uid, overwritten each round.

         Reading the collection is teacher-only: if a student could list
         or read other answers they could see the rest of the class's picks
         before the reveal, which is the whole game. The ONE exception is
         `get` on a student's own doc (2026-10-10): after a reload mid-
         question the client reads its own pick back so the choices come
         back locked instead of offering a second pick (lqRestoreMyAnswer
         in live-quiz.js). `get` only — never `list` — and only where the
         doc id is the caller's uid, so it shows a student nothing they did
         not write themselves.

         The three data conditions are what stop a student from scoring
         themselves. They may only write their OWN uid's doc, only while a
         question is actually open, and only stamped with the round and
         session that are open right now — so a late answer after the
         reveal, or a replayed answer to an earlier question, is rejected
         by the database rather than merely ignored by the UI. The lobby
         case is the "I'm here" write that puts a student in the teacher's
         roster before the first question (qIndex -1, no choice yet).

         hasOnly pins the shape: a client cannot smuggle extra fields (a
         `pts`, say) into a doc the teacher's scoring pass reads back. The
         type conditions under it pin the CONTENTS, which hasOnly does not:
         without them `ms` could be a string or a wild number, and `name`
         (capped at 60 chars only by lqName() in the client) could be any
         length — and the teacher's wall shows that name (it used to be copied
         into liveQuiz/current.scores, which the whole class reads; since
         2026-11-05 the public scores carry no name). Rendering is escaped
         everywhere, so this is about junk and abuse, not XSS.

         `ms` is checked as a number rather than an int on purpose: the
         client rounds it today, and a rule that rejected a fractional value
         would fail answers silently mid-game — the worst possible failure in
         a room of 30 students.

         HONEST LIMIT: none of this stops a student who opens DevTools and
         writes a truthful-looking `ms: 0` for maximum speed points, and
         `ms` IS read for points: only string-id opts out with
         `speedBonus: false`; the three fret quizzes default to speed
         scoring (lqDefaultScoring in live-quiz.js), and the teacher can
         pick "Faster = more points" for any quiz, after which lqPoints()
         scores from `ms`. Timing the answer server-side would close it, and
         that needs no Cloud Function: a rule can pin
         `request.resource.data.at == request.time` (the client already
         writes `at` as serverTimestamp(), which passes), and the scoring
         pass could then time each answer from `at` against
         liveQuiz/current.askedAt instead of trusting `ms`. Not done yet —
         it is a rule change (console re-paste) plus a scoring change.

         Deliberately no delete for students: clearing your own answer
         after seeing the tally would be a free retry. */
      function live() {
        return get(/databases/$(database)/documents/liveQuiz/current).data;
      }
      match /answers/{userId} {
        allow read, delete: if isTeacher();
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
              && request.auth.uid == userId
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.keys().hasOnly(['uid','name','sessionId','qIndex','choice','ms','at'])
              && request.resource.data.name is string
              && request.resource.data.name.size() <= 60
              && request.resource.data.qIndex is int
              && request.resource.data.ms is number
              && request.resource.data.ms >= 0
              && (request.resource.data.choice == null
                  || (request.resource.data.choice is string
                      && request.resource.data.choice.size() <= 64))
              && request.resource.data.sessionId == live().sessionId
              && (
                   (live().state == 'question' && request.resource.data.qIndex == live().qIndex)
                || (live().state == 'lobby'    && request.resource.data.qIndex == -1)
                 );
      }
    }

    /* Student-filed issue reports. A student may file one under their own
       uid and cannot read the pile back — reports can name other students,
       so they are teacher-eyes-only. No update or delete for anyone: a
       report should not be editable after filing.

       hasOnly + the type/size checks below pin this to the exact shape
       submitIssueReport() (app.js) writes — the same reasoning as the
       answers rule above, just without that rule's live-round timing
       conditions (a report isn't scored, so there's nothing to referee).
       Without them a signed-in student could smuggle extra fields into a
       doc the teacher console reads back, or send an unbounded `message`
       (bounded only by Firestore's 1MB doc cap otherwise) — not XSS, the
       console escapes everything, but a data-validation gap worth closing
       the same way `answers` already is. */
    match /issueReports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid','email','name','message','location','moduleNum','setId','lang','userAgent','createdAt'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 4000
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.location is string
                    && request.resource.data.location.size() <= 200
                    && request.resource.data.lang is string
                    && request.resource.data.lang.size() <= 10
                    && request.resource.data.userAgent is string
                    && request.resource.data.userAgent.size() <= 500
                    && request.resource.data.moduleNum is number
                    && (request.resource.data.setId == null
                        || (request.resource.data.setId is string && request.resource.data.setId.size() <= 100));
      allow read:   if isTeacher();
    }

    /* ── Mic recordings (coach.js micRec*, teacher.js "Mic recordings") ──
       Real classroom audio to tune the mic listening on, collected ONLY
       from students who said yes to "Save this take as a recording…".
       Off unless the teacher turns it on (config/class.micSampling).

       One doc per student per game, id "<uid>-<mode>" (mode is "coach" or
       "nr"), overwritten by that student's next consented take. The doc
       holds the take's metadata (expected notes and their times, the
       verdicts, the mic's delay, the device); the audio itself — 24 kHz
       16-bit mono, at most 30 s — is split into chunks/{i} docs, because a
       Firestore doc tops out at 1 MB.

       The id must START with the writer's uid, and `uid` must be theirs, so
       a student can only ever write their own. They cannot read the pile
       back: a take is a recording of a classroom, and only the teacher
       listens to it. Students may delete nothing; the teacher deletes. */
    /* Collection must be switched on in the console (config/class
       .micSampling.on) — the app already checks this before recording; the
       rule makes it true for a write that doesn't come from the app. */
    function micSamplingOn() {
      return get(/databases/$(database)/documents/config/class).data
               .get('micSampling', {}).get('on', false) == true;
    }
    match /micTakes/{takeId} {
      allow create, update: if isSignedIn()
                            && takeId.matches(request.auth.uid + '-(coach|nr|pw)')
                            && request.resource.data.uid == request.auth.uid
                            && micSamplingOn();
      allow read, delete:   if isTeacher();

      match /chunks/{chunkId} {
        allow create, update: if isSignedIn()
                              && takeId.matches(request.auth.uid + '-(coach|nr|pw)')
                              && micSamplingOn()
                              && request.resource.data.keys().hasOnly(['i','pcm'])
                              && request.resource.data.pcm is bytes
                              && request.resource.data.pcm.size() <= 750000;
        allow read, delete:   if isTeacher();
      }
    }

    /* How many takes have been collected, so the prompt stops once the
       teacher's "how many" is reached. Every signed-in student reads it. A
       student may only create it at 1 or add exactly 1, and only to `n`;
       the teacher may set it to anything (Reset counter). A student could
       still add 1 without saving a take — the worst that does is end the
       collection early, which only stops recording. */
    match /micTakesMeta/count {
      allow read:   if isSignedIn();
      allow create: if isTeacher()
                    || (isSignedIn()
                        && request.resource.data.keys().hasOnly(['n'])
                        && request.resource.data.n == 1);
      allow update: if isTeacher()
                    || (isSignedIn()
                        && request.resource.data.keys().hasOnly(['n'])
                        && request.resource.data.n == resource.data.n + 1);
    }

    /* ══ PRACTICE MINUTES (2026-11-01; practice-minutes.js) ═══════════════
       Two NEW blocks, nothing above this line was changed. They must be
       published BEFORE (or with) the site code that writes to them, or every
       write is refused.

       minutes/{uid}/days/{YYYY-MM-DD}  { seconds }
       minutes/{uid}/weeks/{YYYY-Www}   { seconds, goalSeconds, hit }
       Only that signed-in uid reads or writes its own tree — not even the
       teacher (no isTeacher() here on purpose: the numbers are the student's
       own, an ungraded signal). The client adds seconds with increment(), so
       the rule sees the resulting document: a day may hold at most
       dailyCapSeconds() and a week at most seven days of that. No delete.
       ⚠ dailyCapSeconds() is practice-minutes-config.js dailyCapMinutes × 60.
       Raise one, raise the other, re-publish (checks.mjs 1cg fails a push
       where they differ). HONEST LIMIT: a student at DevTools can write any
       number up to the cap for themselves; the cap is the bound, and nothing
       reads these numbers for a grade. */
    function dailyCapSeconds() { return 1200; }
    function pmOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    match /minutes/{userId}/{document=**} {
      allow read: if pmOwner(userId);
    }
    match /minutes/{userId}/days/{day} {
      allow create, update: if pmOwner(userId)
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['seconds'])
            && request.resource.data.seconds is number
            && request.resource.data.seconds >= 0
            && request.resource.data.seconds <= dailyCapSeconds();
    }
    match /minutes/{userId}/weeks/{week} {
      allow create, update: if pmOwner(userId)
            && week.matches('^[0-9]{4}-W[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['seconds', 'goalSeconds', 'hit'])
            && request.resource.data.keys().hasAll(['seconds', 'goalSeconds', 'hit'])
            && request.resource.data.seconds is number
            && request.resource.data.seconds >= 0
            && request.resource.data.seconds <= 7 * dailyCapSeconds()
            && request.resource.data.goalSeconds is number
            && request.resource.data.goalSeconds >= 0
            && request.resource.data.goalSeconds <= 86400
            && request.resource.data.hit is bool;
    }

    /* ── CLASS RANK (2026-11-04; practice-minutes.js, "CLASS RANK") ───────
       minutesBoard/{uid}  { seconds } — the student's all-time practice
       seconds, so My progress can say "N/total". Every signed-in student
       reads the whole collection (that is how a rank is worked out); only
       that uid writes its own doc, with that one field, a number from 0 to
       400 days of the daily cap. No delete. What it exposes: a uid and a
       number — no name and no period in this doc, and a student cannot read
       progress/{uid} to turn a uid into a person. Until 2026-11-05 the live quiz
       kept each player's name under the same uid in liveQuiz/current.scores
       (accepted by Jonathan, 2026-11-04); it no longer does. A person in the
       ROOM can still line the wall's names and points up with the public
       uid -> points (see liveQuiz/current above; open). The teacher reads
       this like any signed-in user.
       HONEST LIMITS: a student at DevTools can write any number up to the
       cap for themselves and so claim first place; any Google account that
       signs in once adds 1 to the total (no domain rule, Jonathan's call);
       nothing reads this for a grade, and the minutes themselves are
       bounded by the rules above. (Comment wording only changed after the
       first publish: no re-paste is needed for it.)
       ⚠ Must be published BEFORE (or with) the site code that writes it. */
    match /minutesBoard/{userId} {
      allow read: if isSignedIn();
      allow create, update: if pmOwner(userId)
            && request.resource.data.keys().hasOnly(['seconds'])
            && request.resource.data.seconds is number
            && request.resource.data.seconds >= 0
            && request.resource.data.seconds <= 400 * dailyCapSeconds();
    }

    /* ── TOP 5 (2026-11-04; practice-minutes.js, "TOP 5") ────────────────
       Jonathan, 2026-11-04: no per-period minutes tied to a name, readable by
       anyone. So the Top 5 board has NO uid and no name in it.

       minutes/{uid}/meta/board  { id } — the student's private name tag: 32
       random hex characters the student's own page makes once. Create-only
       (never changed, never deleted). Only this student reads it: the
       minutes/{uid}/** read rule above is owner-only, not even the teacher.
       The page keeps it in memory only (not localStorage). It is the only
       link between a person and their tag.

       weekBoard/{tag}  { week, period, seconds } — the practice seconds of
       ONE ISO week ('2026-W45') for the student who holds that tag, and their
       class period, so the site can tell a student whether they are in their
       period's Top 5 this week. Every signed-in account reads the collection
       (the site queries one week + one period). A write is allowed only when
       the doc id IS the writer's own tag (the rule reads the writer's
       minutes/{uid}/meta/board; a missing doc denies), with exactly those
       three fields: a week id, a period the site knows, and a number from 0 to
       seven days of the daily cap. A new week overwrites last week's doc (one
       doc per student, ever). No delete.

       What a reader sees here: a random tag, a period, a week and a number.
       No uid, no name, no email.

       minutesBoard (the class rank, above) is still keyed by uid with
       ALL-TIME seconds, nearly the same number as this week's while counting
       is young, so a reader can match a tag to a uid by VALUE (measured on the
       real engine: 58 of 60 students from one read of each). That reaches no
       NAME for an outsider: the live quiz's public scores carry no name any
       more (2026-11-05; checks.mjs 1cm runs the writers), so no doc anyone
       signed in can read has a name next to a uid. ⚠ OPEN (Jonathan decides):
       a person in the ROOM sees the wall's names with their points and can
       read the public uid -> points, which links the top players' uids to
       names (simulated: about half of a speed-scored 30-student game, never a
       wrong link), and from a uid the value join above reaches period and
       minutes. Closing it: key the class rank by this tag too (a parked
       patch, ~/Downloads/rankboard-parked.patch), or key the public scores
       by a per-game token. config/class.periodOverrides is keyed by uid and
       gives a period, never a name.

       HONEST LIMITS: a student at DevTools can write any number up to the cap
       for themselves and place themselves in any period or week. A tag cannot
       be proven unique: any account may create its meta doc with ANY 32-hex id
       (including another student's public tag) and then write that board doc,
       so one account can LOWER or REMOVE one other student's entry (their page
       repairs it on its next confirmed write or reload). Nothing reads this
       for a grade.
       ⚠ Must be published BEFORE (or with) the site code that writes it. */
    match /minutes/{userId}/meta/board {
      allow create: if pmOwner(userId)
            && request.resource.data.keys().hasOnly(['id'])
            && request.resource.data.id is string
            && request.resource.data.id.matches('^[0-9a-f]{32}$');
    }
    match /weekBoard/{tag} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
            && tag == get(/databases/$(database)/documents/minutes/$(request.auth.uid)/meta/board).data.id
            && request.resource.data.keys().hasOnly(['week', 'period', 'seconds'])
            && request.resource.data.keys().hasAll(['week', 'period', 'seconds'])
            && request.resource.data.week is string
            && request.resource.data.week.matches('^[0-9]{4}-W[0-9]{2}$')
            && request.resource.data.period in ['4', '7', 'CAS']
            && request.resource.data.seconds is number
            && request.resource.data.seconds >= 0
            && request.resource.data.seconds <= 7 * dailyCapSeconds();
    }

    /* heartbeats/{sessionId}  { period, lastSeen } — the "N playing" count.
       Firestore cannot make a collection readable "as a count only": a count
       query needs the same read permission as reading the docs. So the docs
       carry nothing worth reading. The id is a random string made once per
       browser session (sessionStorage) — never a uid, and nothing here maps
       back to one. The only fields are the class period and a server
       timestamp; any other field is refused. Any signed-in user may read, so
       the client can count the docs of its own period whose lastSeen is in
       the last 60 s (needs the composite index in firestore.indexes.json).
       lastSeen must equal the server's clock, so it cannot be backdated or
       forged forward. No delete (old docs age out of the 60 s window; a TTL
       policy on lastSeen can clear them — see APPLY-practice-minutes.md).
       HONEST LIMIT: anyone signed in can write a heartbeat for a session id
       they invent, so the count can be inflated; it is a decoration, and it
       is hidden below three players. */
    match /heartbeats/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
            && sessionId.matches('^[0-9a-f]{24}$')
            && request.resource.data.keys().hasOnly(['period', 'lastSeen'])
            && request.resource.data.keys().hasAll(['period', 'lastSeen'])
            && request.resource.data.period in ['4', '7', 'CAS']
            && request.resource.data.lastSeen == request.time;
    }
  }
}
