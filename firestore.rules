rules_version = '2';

/* ══════════════════════════════════════════════════════════════════════
   Guitar Class — Firestore security rules

   THESE RULES ARE THE REAL SECURITY BOUNDARY. Everything in the app is
   client-side and therefore bypassable from DevTools: the ?teacher=true
   dashboard gate is a div swap, and the "paused" flag is a rendering
   choice. Only what is written here actually stops anyone.

   This file is the source of truth, but editing it changes NOTHING on its
   own — GitHub Pages does not deploy Firestore rules. Paste the contents
   into Firebase console → Firestore Database → Rules → Publish (or run
   `firebase deploy --only firestore:rules` if the CLI is ever set up).
   Keep this file and the console in sync; if they drift, the console wins
   and this file becomes a lie.

   The app only ever touches three paths (verified against app.js,
   teacher.js and tabs/journey.js):
     progress/{uid}   one doc per student: skills, responses, completed,
                      games, streak, practiceLog, name, email
     config/class     one shared doc: gamesEnabled, gameOverrides,
                      paused, archived, periodOverrides, hiddenActivities,
                      activityDates, activityTitles, activityNumbers,
                      activityClears, archivedActivities, deletedActivities,
                      optionalActivities, playAlongActivities, activityPins,
                      activityStudents,
                      activityBoard,
                      activityBoardSeeded, moduleOpenThrough,
                      micSampling, configVersion
                      (teacher writes, students read)
     config/access    the outside (not @seq.org) accounts allowed in:
                      { allow: { uid: true } } (teacher reads and writes,
                      2026-11-13)
     accessRequests/{uid}  "Ask your teacher to let me in" from an account
                      that is not let in: the asker creates its own, once;
                      the teacher reads, decides, deletes (2026-11-13)
     liveQuiz/current the whole-class live quiz's state (teacher writes,
                      students read) + an answers/{uid} subcollection each
                      student writes their own row of
     issueReports/*   student-filed problem reports
     micTakes/*       consented mic recordings of one Listening Coach /
                      Note Runner / Power Chord Switch take (+ a chunks/{i} subcollection of
                      the audio) — student creates their own, teacher
                      reads and deletes
     micTakesMeta/count  the public "how many takes so far" counter
     minutes/{uid}/*  practice minutes (days, weeks, meta/board) — the student
                      writes and reads their own; the teacher reads weeks
                      (2026-11-06) and days (2026-11-13), nothing else
     rankBoard/{tag}, weekBoard/{tag}  the class rank and the Top 5, keyed by a private
                      name tag (minutes/{uid}/meta/board), readable by every signed-in
                      account. minutesBoard/{uid} has NO block (denied).
     siteErrors/*     the anonymous error log (2026-11-13): any signed-in
                      account creates, the teacher reads and deletes
     songRequests/*   a student's song request, one per week (2026-11-13):
                      the student creates and reads their own, the teacher
                      reads, sets the state and deletes

   Anything not matched below is denied by default. Do not add a catch-all.
   ══════════════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* The one teacher account. email_verified matters: without it, anyone
       who could register this address under a provider that doesn't verify
       (enabling Email/Password is a single console toggle with no footprint
       in this repo) would read every student's work. Google sign-in — the
       only provider the app uses — always sets email_verified, so adding
       this does not lock the real teacher out. */
    function isTeacher() {
      return request.auth != null
          && request.auth.token.email == 'jhoffman@seq.org'
          && request.auth.token.email_verified == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    /* One document per student, keyed by uid.

       A student reads and writes ONLY their own. The teacher gets read —
       deliberately NOT write. The dashboard never needs to modify student
       work (pause and archive live in config/class precisely so they
       don't), and withholding write means a compromised teacher session
       cannot erase the class. If a destructive "wipe progress" button is
       ever added, it needs `allow delete: if isTeacher()` here, and that
       trade-off should be a deliberate decision rather than a default. */
    match /progress/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read: if isTeacher();
    }

    /* Class-wide settings. Every signed-in student must read this doc —
       app.js loadClassConfig() needs gamesEnabled/gameOverrides for the
       arcade, `paused` for the access hold, and `hiddenActivities` /
       `archivedActivities` / `deletedActivities` to skip any In-Class
       Activity the teacher has pulled back or retired — so it cannot be
       teacher-only.

       What that exposes: the uid→bool maps for the whole class (plus an
       activity-id→bool map, which isn't sensitive — activity ids already
       ship to every client in class-activities.js). It is limited in
       practice, because uids are opaque and a student cannot read anyone
       else's progress doc to map a uid back to a name. If that ever stops
       being acceptable, the fix is structural rather than a rules tweak:
       split into config/students/{uid} docs so each student can read only
       their own row.

       Scoped to the specific "class" doc — config/{doc} would let any
       signed-in user read every doc under config/, not just this one.

       `configVersion` is a counter the console bumps on every write, inside
       a transaction, so a second console cannot merge a patch it worked out
       from a copy of this doc that has since moved (teacherWriteConfig in
       teacher.js, checks.mjs 1ai). Deliberately NOT enforced here: a rule
       like `request.resource.data.configVersion == resource.data.configVersion + 1`
       would make the doc unwritable from the Firebase console by hand, which
       is the one repair path left when something goes wrong with it. The
       guard is there to stop an accident, not an attacker — and only the
       teacher can write this doc at all. */
    match /config/class {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    /* ── OUTSIDE ACCOUNTS ALLOWED IN (2026-11-13; teacher-accounts.js) ──
       config/access  { allow: { <uid>: true, ... } }
       The accounts that may use the class site although their Google
       address is not @seq.org: CAS students on outside accounts and the
       teacher's own test accounts (Jonathan, 2026-11-13: "outside accounts
       in CAS are okay with me"). The teacher alone reads and writes it, in
       the console's Manage view ("Accounts by sign-in domain"); a student
       cannot read the list, so it shows nobody which accounts are outside.
       No uid is written in this file (the repo is public).

       The console only ever MERGES one key at a time (set with
       { merge: true }, FieldValue.delete() to remove), so two console tabs
       switching different accounts both land. A whole-document set() from
       the Firebase console replaces the list: edit a single key there.

       Shape: the one field `allow`, a map. Rules cannot check every entry;
       the check that reads this list (isSchool(), the second paste) counts
       an entry only when its value is exactly true.
       No delete for anyone through the rules (switching every account off
       leaves { allow: {} }, which means the same as no document at all).

       SIZE: a Firestore document holds at most 1 MiB. An entry is a
       28-character uid plus a boolean, about 31 bytes, so the list holds
       about 30,000 accounts. */
    match /config/access {
      allow read: if isTeacher();
      allow create, update: if isTeacher()
            && request.resource.data.keys().hasOnly(['allow'])
            && request.resource.data.allow is map;
    }

    /* ── ASKING TO JOIN (2026-11-13; app/boot.js accessAsk*, teacher-accounts.js) ──
       accessRequests/{uid}  { name, email, at, status }
       An account that is not let in (not @seq.org, not on config/access)
       sees one screen instead of the site, with "Ask your teacher to let me
       in". Pressing it creates THIS document, once. The teacher sees it in
       the console (a count on Manage, and the list with Allow / Decline).

       The asker: only its own uid, only once (create; never update or
       delete, so it cannot ask again after a Decline, and cannot change
       what it sent). name and email must be exactly the sign-in token's
       (Google's) values, so nobody can file a request under a made-up name
       (an account with no name claim sends ''), and the email must be
       verified (Google sign-in always is; this is for the day another
       sign-in method is switched on); at must be the server's
       time (the client sends serverTimestamp()); status must be 'asked'.
       It may `get` its own document (to show "asked" or "declined"); never
       `list`: one asker cannot see another.
       The teacher: reads and lists, deletes, and may change only `status`,
       to 'allowed' or 'declined'. Decline is what silences an account: its
       request stays, and it cannot ask again. Delete removes the line and
       lets that account ask again (it is not the button for spam). Allowing an account is the
       write to config/access; status here is what the asker's screen says.

       What this lets a stranger do: anyone with a Google account can create
       ONE small document (its own uid, under 600 characters in all). The
       console reads at most the newest 200 waiting requests.
       Nothing a student can read holds another person's name or email. */
    match /accessRequests/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.keys().hasOnly(['name', 'email', 'at', 'status'])
            && request.resource.data.keys().hasAll(['name', 'email', 'at', 'status'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 200
            && request.resource.data.name == request.auth.token.get('name', '')
            && request.resource.data.email is string
            && request.resource.data.email.size() > 0
            && request.resource.data.email.size() <= 320
            && request.resource.data.email == request.auth.token.get('email', '')
            && request.auth.token.get('email_verified', false) == true
            && request.resource.data.at == request.time
            && request.resource.data.status == 'asked';
      allow read, delete: if isTeacher();
      allow update: if isTeacher()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['allowed', 'declined'];
    }

    /* ── Live quiz (live-quiz.js) ──────────────────────────────────────
       One doc, rewritten from scratch each game. Only the teacher writes
       it: state, the current question number, the correct answer (written
       only at reveal) and the running scores. Every signed-in student
       reads it, which is what makes the game live.

       What that exposes: the `scores` map — every player's POINTS, keyed by
       uid — is readable by any signed-in account. It carries NO NAME
       (2026-11-05, Jonathan: no per-period minutes tied to a name, readable
       by anyone): names stay in answers/{uid} below (teacher-only), and the
       projected wall, which is the teacher's own screen, builds its
       leaderboard from those. Before that the scores map held every
       player's display name next to the uid, which tied every uid-keyed doc
       on the site (config/class's uid maps, the class rank, the minutes
       boards) to a person; the Top 5 board is keyed by a private tag as
       well, in case a name is ever published again. checks.mjs 1cm runs the
       writers and fails the push if a name gets back into this doc. A
       person in the room sees the wall's names with points and can read this
       doc's uid -> points, so the top players' uids can be lined up with their
       names; from a uid nothing reaches minutes (rankBoard and weekBoard
       are keyed by a private tag, minutesBoard has no rules block).

       Scoped to the specific "current" doc rather than liveQuiz/{doc}, for
       the same reason config/class is: a wildcard would open every future
       document under liveQuiz/ to every signed-in user. */
    match /liveQuiz/current {
      allow read:  if isSignedIn();
      allow write: if isTeacher();

      /* One answer doc per student, keyed by uid, overwritten each round.

         Reading the collection is teacher-only: if a student could list
         or read other answers they could see the rest of the class's picks
         before the reveal, which is the whole game. The ONE exception is
         `get` on a student's own doc (2026-10-10): after a reload mid-
         question the client reads its own pick back so the choices come
         back locked instead of offering a second pick (lqRestoreMyAnswer
         in live-quiz.js). `get` only — never `list` — and only where the
         doc id is the caller's uid, so it shows a student nothing they did
         not write themselves.

         The three data conditions are what stop a student from scoring
         themselves. They may only write their OWN uid's doc, only while a
         question is actually open, and only stamped with the round and
         session that are open right now — so a late answer after the
         reveal, or a replayed answer to an earlier question, is rejected
         by the database rather than merely ignored by the UI. The lobby
         case is the "I'm here" write that puts a student in the teacher's
         roster before the first question (qIndex -1, no choice yet).

         hasOnly pins the shape: a client cannot smuggle extra fields (a
         `pts`, say) into a doc the teacher's scoring pass reads back. The
         type conditions under it pin the CONTENTS, which hasOnly does not:
         without them `ms` could be a string or a wild number, and `name`
         (capped at 60 chars only by lqName() in the client) could be any
         length — and the teacher's wall shows that name (it used to be copied
         into liveQuiz/current.scores, which the whole class reads; since
         2026-11-05 the public scores carry no name). Rendering is escaped
         everywhere, so this is about junk and abuse, not XSS.

         `ms` is checked as a number rather than an int on purpose: the
         client rounds it today, and a rule that rejected a fractional value
         would fail answers silently mid-game — the worst possible failure in
         a room of 30 students.

         HONEST LIMIT: none of this stops a student who opens DevTools and
         writes a truthful-looking `ms: 0` for maximum speed points, and
         `ms` IS read for points: only string-id opts out with
         `speedBonus: false`; the three fret quizzes default to speed
         scoring (lqDefaultScoring in live-quiz.js), and the teacher can
         pick "Faster = more points" for any quiz, after which lqPoints()
         scores from `ms`. Timing the answer server-side would close it, and
         that needs no Cloud Function: a rule can pin
         `request.resource.data.at == request.time` (the client already
         writes `at` as serverTimestamp(), which passes), and the scoring
         pass could then time each answer from `at` against
         liveQuiz/current.askedAt instead of trusting `ms`. Not done yet —
         it is a rule change (console re-paste) plus a scoring change.

         Deliberately no delete for students: clearing your own answer
         after seeing the tally would be a free retry. */
      function live() {
        return get(/databases/$(database)/documents/liveQuiz/current).data;
      }
      match /answers/{userId} {
        allow read, delete: if isTeacher();
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
              && request.auth.uid == userId
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.keys().hasOnly(['uid','name','sessionId','qIndex','choice','ms','at'])
              && request.resource.data.name is string
              && request.resource.data.name.size() <= 60
              && request.resource.data.qIndex is int
              && request.resource.data.ms is number
              && request.resource.data.ms >= 0
              && (request.resource.data.choice == null
                  || (request.resource.data.choice is string
                      && request.resource.data.choice.size() <= 64))
              && request.resource.data.sessionId == live().sessionId
              && (
                   (live().state == 'question' && request.resource.data.qIndex == live().qIndex)
                || (live().state == 'lobby'    && request.resource.data.qIndex == -1)
                 );
      }
    }

    /* Student-filed issue reports. A student may file one under their own
       uid and cannot read the pile back — reports can name other students,
       so they are teacher-eyes-only. No update or delete for anyone: a
       report should not be editable after filing.

       hasOnly + the type/size checks below pin this to the exact shape
       submitIssueReport() (app.js) writes — the same reasoning as the
       answers rule above, just without that rule's live-round timing
       conditions (a report isn't scored, so there's nothing to referee).
       Without them a signed-in student could smuggle extra fields into a
       doc the teacher console reads back, or send an unbounded `message`
       (bounded only by Firestore's 1MB doc cap otherwise) — not XSS, the
       console escapes everything, but a data-validation gap worth closing
       the same way `answers` already is. */
    match /issueReports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid','email','name','message','location','moduleNum','setId','lang','userAgent','createdAt'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 4000
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.location is string
                    && request.resource.data.location.size() <= 200
                    && request.resource.data.lang is string
                    && request.resource.data.lang.size() <= 10
                    && request.resource.data.userAgent is string
                    && request.resource.data.userAgent.size() <= 500
                    && request.resource.data.moduleNum is number
                    && (request.resource.data.setId == null
                        || (request.resource.data.setId is string && request.resource.data.setId.size() <= 100));
      allow read:   if isTeacher();
    }

    /* ── Mic recordings (coach.js micRec*, teacher.js "Mic recordings") ──
       Real classroom audio to tune the mic listening on, collected ONLY
       from students who said yes to "Save this take as a recording…".
       Off unless the teacher turns it on (config/class.micSampling).

       One doc per student per game, id "<uid>-<mode>" (mode is "coach" or
       "nr"), overwritten by that student's next consented take. The doc
       holds the take's metadata (expected notes and their times, the
       verdicts, the mic's delay, the device); the audio itself — 24 kHz
       16-bit mono, at most 30 s — is split into chunks/{i} docs, because a
       Firestore doc tops out at 1 MB.

       The id must START with the writer's uid, and `uid` must be theirs, so
       a student can only ever write their own. They cannot read the pile
       back: a take is a recording of a classroom, and only the teacher
       listens to it. Students may delete nothing; the teacher deletes. */
    /* Collection must be switched on in the console (config/class
       .micSampling.on) — the app already checks this before recording; the
       rule makes it true for a write that doesn't come from the app. */
    function micSamplingOn() {
      return get(/databases/$(database)/documents/config/class).data
               .get('micSampling', {}).get('on', false) == true;
    }
    match /micTakes/{takeId} {
      allow create, update: if isSignedIn()
                            && takeId.matches(request.auth.uid + '-(coach|nr|pw)')
                            && request.resource.data.uid == request.auth.uid
                            && micSamplingOn();
      allow read, delete:   if isTeacher();

      match /chunks/{chunkId} {
        allow create, update: if isSignedIn()
                              && takeId.matches(request.auth.uid + '-(coach|nr|pw)')
                              && micSamplingOn()
                              && request.resource.data.keys().hasOnly(['i','pcm'])
                              && request.resource.data.pcm is bytes
                              && request.resource.data.pcm.size() <= 750000;
        allow read, delete:   if isTeacher();
      }
    }

    /* How many takes have been collected, so the prompt stops once the
       teacher's "how many" is reached. Every signed-in student reads it. A
       student may only create it at 1 or add exactly 1, and only to `n`;
       the teacher may set it to anything (Reset counter). A student could
       still add 1 without saving a take — the worst that does is end the
       collection early, which only stops recording. */
    match /micTakesMeta/count {
      allow read:   if isSignedIn();
      allow create: if isTeacher()
                    || (isSignedIn()
                        && request.resource.data.keys().hasOnly(['n'])
                        && request.resource.data.n == 1);
      allow update: if isTeacher()
                    || (isSignedIn()
                        && request.resource.data.keys().hasOnly(['n'])
                        && request.resource.data.n == resource.data.n + 1);
    }

    /* ══ PRACTICE MINUTES (2026-11-01; practice-minutes.js) ═══════════════
       Two NEW blocks, nothing above this line was changed. They must be
       published BEFORE (or with) the site code that writes to them, or every
       write is refused.

       minutes/{uid}/days/{YYYY-MM-DD}  { seconds }
       minutes/{uid}/weeks/{YYYY-Www}   { seconds, goalSeconds, hit }
       Only that signed-in uid writes its own tree, and reads all of it. The
       teacher's account reads the weeks docs (2026-11-06: the console's
       "Practice minutes" view, teacher.js, shows every student's week,
       streak, rank and Top 5 place, worked out from the weeks docs) and the
       days docs (2026-11-13: the Students view's "Back from an absence"
       filter reads which days a student saved work), and nothing else under
       minutes/: never meta/board (the private tag). The teacher
       never writes here. The client adds seconds with increment(), so
       the rule sees the resulting document: a day may hold at most
       dailyCapSeconds() and a week at most seven days of that. No delete.
       ⚠ dailyCapSeconds() is practice-minutes-config.js dailyCapMinutes × 60.
       Raise one, raise the other, re-publish (checks.mjs 1cg fails a push
       where they differ). HONEST LIMIT: a student at DevTools can write any
       number up to the cap for themselves; the cap is the bound, and nothing
       reads these numbers for a grade. */
    function dailyCapSeconds() { return 1200; }
    function pmOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    match /minutes/{userId}/{document=**} {
      allow read: if pmOwner(userId);
    }
    match /minutes/{userId}/days/{day} {
      allow read: if isTeacher();   // 2026-11-13: the console's "Back from an absence" filter reads which days a student saved work (read only)
      allow create, update: if pmOwner(userId)
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['seconds'])
            && request.resource.data.seconds is number
            && request.resource.data.seconds >= 0
            && request.resource.data.seconds <= dailyCapSeconds();
    }
    match /minutes/{userId}/weeks/{week} {
      allow read: if isTeacher();
      allow create, update: if pmOwner(userId)
            && week.matches('^[0-9]{4}-W[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['seconds', 'goalSeconds', 'hit'])
            && request.resource.data.keys().hasAll(['seconds', 'goalSeconds', 'hit'])
            && request.resource.data.seconds is number
            && request.resource.data.seconds >= 0
            && request.resource.data.seconds <= 7 * dailyCapSeconds()
            && request.resource.data.goalSeconds is number
            && request.resource.data.goalSeconds >= 0
            && request.resource.data.goalSeconds <= 86400
            && request.resource.data.hit is bool;
    }

    /* minutesBoard/{uid} (the uid-keyed class rank, 2026-11-04) HAS NO RULES BLOCK ANY MORE (2026-11-05): with no match, every read and
       write is denied. Jonathan's rule (no minutes tied to a name, readable by anyone) ruled the uid out: see rankBoard below. Its old docs
       are unreachable and can be deleted in the Firebase console. Do not add a block for it back. */

    /* ── TOP 5 (2026-11-04; practice-minutes.js, "TOP 5") ────────────────
       Jonathan, 2026-11-04: no per-period minutes tied to a name, readable by
       anyone. So the Top 5 board has NO uid and no name in it.

       minutes/{uid}/meta/board  { id } — the student's private name tag: 32
       random hex characters the student's own page makes once. Create-only
       (never changed, never deleted). Only this student reads it: the
       minutes/{uid}/** read rule above is owner-only, not even the teacher.
       (Since 2026-11-06 the teacher reads minutes/{uid}/weeks/* — the
       console's Practice minutes view — but still not this doc, and the
       console never reads the boards. The teacher's account COULD now line
       a student's week total up with a weekBoard doc by value; that shows
       the teacher nothing the console does not already show by name, and
       gives no student anything.) The page keeps it in memory only (not
       localStorage). For every account but the teacher it is the only link
       between a person and their tag.

       weekBoard/{tag}  { week, period, seconds } — the practice seconds of
       ONE ISO week ('2026-W45') for the student who holds that tag, and their
       class period, so the site can tell a student whether they are in their
       period's Top 5 this week. Every signed-in account reads the collection
       (the site queries one week + one period). A write is allowed only when
       the doc id IS the writer's own tag (the rule reads the writer's
       minutes/{uid}/meta/board; a missing doc denies), with exactly those
       three fields: a week id, a period the site knows, and a number from 0 to
       seven days of the daily cap. A new week overwrites last week's doc (one
       doc per student, ever). No delete.

       What a reader sees here: a random tag, a period, a week and a number.
       No uid, no name, no email.

       The class rank is keyed by the same tag (rankBoard, below) and the
       uid-keyed minutesBoard is gone, so neither board holds anything that
       joins to a uid: a person in the ROOM who lines the wall's names and
       points up with the public liveQuiz uid -> points learns a uid, a name
       and points, and still cannot reach minutes or a period from that uid.
       config/class.periodOverrides[uid] is readable by every student and
       does tie a uid to a period for the students the teacher corrected
       (a period, never a name, and not part of this change).

       HONEST LIMITS: a student at DevTools can write any number up to the cap
       for themselves and place themselves in any period or week. A tag cannot
       be proven unique: any account may create its meta doc with ANY 32-hex id
       (including another student's public tag) and then write that board doc,
       so one account can LOWER or REMOVE one other student's entry (their page
       repairs it on its next confirmed write or reload). Nothing reads this
       for a grade.
       ⚠ Must be published BEFORE (or with) the site code that writes it. */
    match /minutes/{userId}/meta/board {
      allow create: if pmOwner(userId)
            && request.resource.data.keys().hasOnly(['id'])
            && request.resource.data.id is string
            && request.resource.data.id.matches('^[0-9a-f]{32}$');
    }
    match /weekBoard/{tag} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
            && tag == get(/databases/$(database)/documents/minutes/$(request.auth.uid)/meta/board).data.id
            && request.resource.data.keys().hasOnly(['week', 'period', 'seconds'])
            && request.resource.data.keys().hasAll(['week', 'period', 'seconds'])
            && request.resource.data.week is string
            && request.resource.data.week.matches('^[0-9]{4}-W[0-9]{2}$')
            && request.resource.data.period in ['4', '7', 'CAS']
            && request.resource.data.seconds is number
            && request.resource.data.seconds >= 0
            && request.resource.data.seconds <= 7 * dailyCapSeconds();
    }

    /* ── CLASS RANK (2026-11-05; practice-minutes.js, "CLASS RANK") ───────
       rankBoard/{tag}  { seconds } — the student's all-time practice
       seconds, so My progress can say "N/total". It replaces the uid-keyed
       minutesBoard: keyed by the SAME private tag as weekBoard, so no uid
       or name is in it, and so the two boards cannot be joined to a person
       (before, this week's and all-time seconds were nearly the same number
       and minutesBoard was keyed by uid, so a plain value match linked a tag
       to a uid, and the live quiz links a uid to a name). Every signed-in
       account reads the whole collection (that is how a rank is worked
       out); a write is allowed only under the writer's own tag, with that
       one field, a number from 0 to 400 days of the daily cap. No delete.
       HONEST LIMITS: as weekBoard (a student at DevTools can claim first
       place for themselves; a tag cannot be proven unique, so one account can
       overwrite one other student's entry, and UNLIKE weekBoard the victim's
       page never repairs this one: it only adds; any Google account that signs
       in once adds 1 to the total: no domain rule, Jonathan's call). Nothing
       reads this for a grade.
       ⚠ Must be published BEFORE (or with) the site code that writes it. */
    match /rankBoard/{tag} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
            && tag == get(/databases/$(database)/documents/minutes/$(request.auth.uid)/meta/board).data.id
            && request.resource.data.keys().hasOnly(['seconds'])
            && request.resource.data.seconds is number
            && request.resource.data.seconds >= 0
            && request.resource.data.seconds <= 400 * dailyCapSeconds();
    }

    /* ── ERROR LOG (2026-11-13; app/boot.js SITE_ERRORS, teacher-errors.js) ──
       A NEW block; no rule above it was changed (only the path list at
       the top of this file gained a line). When the site throws on a
       student's Chromebook, the page writes one small ANONYMOUS doc here so
       the teacher console's "Error log" view shows it the same day.

       siteErrors/{autoId}  { kind, message, file, line, col, stack, page,
                              version, day, lang }
       No uid, name, email or class period field, no time finer than the day
       (Jonathan, 2026-11-04: nothing readable by others may tie a name or
       uid to a period). Before writing, the client scrubs from the text the
       signed-in account's own uid, email and name, any email address, query
       strings, id-like runs of letters and digits, and runs of 6+ digits; it
       cannot know anyone else's name, a class period or what a student typed,
       so an error message that quotes those keeps them. These rules pin the
       SHAPE: the exact ten fields (hasOnly + hasAll), each type, a size cap
       on every string (1,284 UTF-16 units in all, at most about 4 KB), the
       doc id (20 letters and digits, the form of the SDK's own auto-ids, so
       an id cannot carry a name), and the day: a real date at most one day
       either side of the server's UTC date (a device's local date is always
       within that), so a wrong clock cannot write a day in the future that
       would sort above every real entry.

       Any signed-in account may CREATE one (the logger runs only when someone
       is signed in). Nobody may update one. Only the teacher reads (the
       Error log view) and deletes ("Delete older than 30 days"); a student
       cannot read the pile back.

       HONEST LIMITS: a student at DevTools can create as many docs as they
       like, with any text that fits the caps (rules cannot count writes); the
       console escapes every value, and the teacher can delete them. Firestore
       itself keeps a server create time on every doc (not a field, but the
       Admin SDK and REST API show it); only the teacher can read these docs.
       ⚠ Must be published BEFORE the site code that writes it. (Published
       late, the client is refused once, silently, and stops trying for that
       page load.) */
    match /siteErrors/{errorId} {
      /* The stated day (already checked to be YYYY-MM-DD) as a date, within one
         day of request.time's UTC date. An impossible date (month 13, Feb 30,
         year 0) is an evaluation error, which denies. */
      function siteErrorDayNear(day) {
        let stated = timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
        let utcDay = request.time.date();
        return stated >= utcDay - duration.value(1, 'd')
            && stated <= utcDay + duration.value(1, 'd');
      }
      allow create: if isSignedIn()
            && errorId.matches('^[A-Za-z0-9]{20}$')
            && request.resource.data.keys().hasOnly(['kind', 'message', 'file', 'line', 'col', 'stack', 'page', 'version', 'day', 'lang'])
            && request.resource.data.keys().hasAll(['kind', 'message', 'file', 'line', 'col', 'stack', 'page', 'version', 'day', 'lang'])
            && request.resource.data.kind in ['error', 'rejection']
            && request.resource.data.message is string
            && request.resource.data.message.size() > 0
            && request.resource.data.message.size() <= 300
            && request.resource.data.file is string
            && request.resource.data.file.size() <= 200
            && request.resource.data.line is int
            && request.resource.data.line >= 0
            && request.resource.data.line <= 10000000
            && request.resource.data.col is int
            && request.resource.data.col >= 0
            && request.resource.data.col <= 10000000
            && request.resource.data.stack is string
            && request.resource.data.stack.size() <= 600
            && request.resource.data.page is string
            && request.resource.data.page.size() <= 120
            && request.resource.data.version is string
            && request.resource.data.version.size() <= 64
            && request.resource.data.day is string
            && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && siteErrorDayNear(request.resource.data.day)
            && request.resource.data.lang in ['en', 'es'];
      allow read, delete: if isTeacher();
    }

    /* ── SONG REQUESTS (2026-11-13; app/songrequests.js, teacher-songrequests.js) ──
       A NEW block; no rule above it was changed (only the path list at the
       top of this file gained a line). A student asks for a song: a YouTube
       link and two yes/no answers (are the lyrics right for class, is what
       the song is about right for class), a reason when either answer is no,
       and an optional title. The console's "Song requests" view lists them.

       songRequests/{uid}_{week}  { uid, name, email, period, week, videoId,
                                    url, lyricsOk, topicOk, why, title,
                                    createdAt, state [, note] }
       ONE REQUEST PER STUDENT PER WEEK (Jonathan, 2026-11-13). The doc id is
       the student's uid, "_" and the ISO week ('2026-W47', Monday first, the
       week practice minutes uses), and a student may only CREATE: a second
       request in the same week writes to a doc that exists, which is an
       update, and students have no update. The week must be the one that
       holds request.time, give or take one day (a student's local week
       starts up to 14 hours away from the UTC one), and its Thursday must
       fall in the stated year (so "2027-W53", a week that does not exist,
       is refused). The used turn stays used whatever the teacher answers;
       only the teacher's Delete gives it back.

       A create carries exactly these fields: its own uid; a name up to 200;
       the sign-in token's own email (so a request cannot carry a classmate's
       address); a period the site knows or ''; the week of the id; an
       11-character YouTube video id and the one link built from it (the page
       never stores pasted text as a link); the two answers as booleans; the
       reason: empty when both answers are yes, required (up to 200, with at
       least one character that is not a space) when either is no; a title up
       to 80; createdAt = the server's time; and
       state 'asked'.

       A student reads only their own (the page queries where uid == theirs;
       one equality, no composite index). The teacher reads all, deletes, and
       updates only `state` (asked, adding, declined) and `note` (a short
       line to the student, up to 200). Nobody else updates.

       HONEST LIMITS: one account makes at most one request per week, two at
       a week boundary (the week before or after is accepted for one day).
       In this published text any signed-in Google account may ask; the
       school-accounts paste 2 (firestore.rules.paste2) gates the create and
       the student's read with isSchool(), like every other student rule.
       The name, title and reason are free text within their caps (the name
       is NOT shown as the student's identity: the console names a request by
       its uid from the roster, else by the email, which the rule ties to the
       sign-in token); the console escapes every value.
       student-side: becomes isSchool() with the school-accounts paste 2
       ⚠ Must be published BEFORE the site code that writes it (until then
       the page says requests are not open yet). */
    function songRequestNow() { return request.time; }
    function songRequestWeekOk(week) {
      let y = int(week[0:4]);
      let w = int(week[6:8]);
      let jan4 = timestamp.date(y, 1, 4);
      let monday = jan4 - duration.value(jan4.dayOfWeek() - 1, 'd') + duration.value((w - 1) * 7, 'd');
      return w >= 1 && w <= 53
          && (monday + duration.value(3, 'd')).year() == y
          && songRequestNow() >= monday - duration.value(1, 'd')
          && songRequestNow() < monday + duration.value(8, 'd');
    }
    match /songRequests/{requestId} {
      allow create: if isSignedIn()
            && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'period', 'week', 'videoId', 'url', 'lyricsOk', 'topicOk', 'why', 'title', 'createdAt', 'state'])
            && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'period', 'week', 'videoId', 'url', 'lyricsOk', 'topicOk', 'why', 'title', 'createdAt', 'state'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.week is string
            && request.resource.data.week.matches('^[0-9]{4}-W[0-9]{2}$')
            && requestId == request.auth.uid + '_' + request.resource.data.week
            && songRequestWeekOk(request.resource.data.week)
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 200
            && request.resource.data.email is string
            && request.resource.data.email.size() <= 200
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.period in ['4', '7', 'CAS', '']
            && request.resource.data.videoId is string
            && request.resource.data.videoId.matches('^[A-Za-z0-9_-]{11}$')
            && request.resource.data.url == 'https://www.youtube.com/watch?v=' + request.resource.data.videoId
            && request.resource.data.lyricsOk is bool
            && request.resource.data.topicOk is bool
            && request.resource.data.why is string
            && request.resource.data.why.size() <= 200
            && ((request.resource.data.lyricsOk && request.resource.data.topicOk && request.resource.data.why.size() == 0)
                || ((!request.resource.data.lyricsOk || !request.resource.data.topicOk) && request.resource.data.why.matches('(?s).*[^ \t\r\n].*')))
            && request.resource.data.title is string
            && request.resource.data.title.size() <= 80
            && request.resource.data.createdAt == request.time
            && request.resource.data.state == 'asked';
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow read, delete: if isTeacher();
      allow update: if isTeacher()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'note'])
            && request.resource.data.state in ['asked', 'adding', 'declined']
            && (!('note' in request.resource.data)
                || (request.resource.data.note is string && request.resource.data.note.size() <= 200));
    }
  }
}
