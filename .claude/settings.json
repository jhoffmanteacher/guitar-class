{
  "permissions": {
    "allow": [
      "Bash(node tools/checks.mjs --check --skip-links)",
      "Bash(node tools/checks.mjs)",
      "Bash(node tools/checks.mjs --skip-links)",
      "Bash(node tools/checks.mjs --check)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git pull *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(curl * youtube.com/oembed*)",
      "Bash(curl * www.youtube.com/oembed*)",
      "Bash(curl * justinguitar.com*)",
      "Bash(curl -s *)",
      "Bash(node --check *)",
      "Bash(node -c *)",
      "WebSearch",
      "WebFetch(domain:www.youtube.com)",
      "WebFetch(domain:www.justinguitar.com)",
      "WebFetch(domain:community.justinguitar.com)",
      "WebFetch(domain:tabs.ultimate-guitar.com)",
      "Skill(update-config)",
      "Skill(fewer-permission-prompts)",
      "Read",
      "Grep",
      "Glob",
      "Edit(module-*.js)",
      "Edit(config-main.js)",
      "Edit(index.html)",
      "Edit(sw.js)",
      "Edit(CHANGELOG.md)",
      "Edit(WORKFLOW.md)"
    ],
    "deny": [
      "Read(~/Documents/mic-recordings-*)",
      "Read(~/Downloads/mic-recordings-*)",
      "Read(~/Desktop/mic-recordings-*)",
      "Read(~/Documents/guitar-class-backup-*)",
      "Read(~/Downloads/guitar-class-backup-*)",
      "Read(~/Desktop/guitar-class-backup-*)",
      "Read(~/Documents/guitar-class-private/**)",
      "Read(**/guitar-class-private/**)",
      "Read(**/guitar-class-backup-*.json)",
      "Read(**/mic-recordings-*.zip)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-checks.mjs\"",
            "timeout": 150,
            "statusMessage": "Running the repo's offline checks…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob|Artifact|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/no-student-data.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
